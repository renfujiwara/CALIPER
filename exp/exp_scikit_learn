def ema_weights(n, lam):
    return lam ** np.arange(n-1, -1, -1)

class _BaseSKExp(Exp_Basic):
    def __init__(self, args):
        super().__init__(args)
        self.input_channels_dim = args.enc_in
        self.online = getattr(args, 'online', 'none') 
        self.model = None  # sklearn estimator
        self.rho = 0.99

    def model_init(self, args):
        raise NotImplementedError
    
    def set_mode(self, mode):
        return None

    def _slice_target(self, y):
        f_dim = -1 if self.args.features == 'MS' else 0
        return y[:, -self.args.pred_len:, f_dim:]

    def _batch_to_Xy(self, batch_x, batch_y):
        # batch_x:[B,L,C] → [B, L*C],  y:[B,H,Csel] → [B, H*Csel]
        B, L, C = batch_x.shape
        y = self._slice_target(batch_y)                  # (B,H,Csel)
        X_feat = batch_x.reshape(B, L * C)
        Y_feat = y.reshape(B, self.args.pred_len * y.shape[-1])
        return X_feat, Y_feat, y.shape[-1]

    def _collect_from_loader(self, loader):
        Xs, Ys = [], []
        Csel = None
        for (bx, by, *_) in loader:
            X, Y, Csel = self._batch_to_Xy(bx, by)
            Xs.append(X); Ys.append(Y)
        return np.concatenate(Xs, 0), np.concatenate(Ys, 0), Csel

    def _predict_loader(self, loader):
        preds, trues = [], []
        Csel = None
        for (bx, by, *_rest) in loader:
            X, Y, Csel = self._batch_to_Xy(bx.float(), by.float())
            Y_hat = self.model.predict(X)  # numpy (B, H*Csel)
            B = Y.shape[0]
            y_hat = torch.as_tensor(
                Y_hat.reshape(B, self.args.pred_len, Csel),
                dtype=torch.float32, device=self.device
            )
            y_true = torch.as_tensor(
                Y.reshape(B, self.args.pred_len, Csel),
                dtype=torch.float32, device=self.device
            )
            preds.append(y_hat)
            trues.append(y_true)

        if len(preds) == 0:
            raise RuntimeError("predict_loader: got zero batches from loader.")

        return torch.cat(preds, dim=0), torch.cat(trues, dim=0)
    

    def _predict_and_update_loader(self, loader):
        preds, trues = [], []
        ct = []
        Csel = None
        update_every = 10
        bufX, bufY = deque(maxlen=64), deque(maxlen=64)
        for i, (bx, by, _, _, update_x, update_y, _, _, is_update_batch) in enumerate(loader):
            X, Y, Csel = self._batch_to_Xy(bx.float(), by.float())
            update=is_update_batch.flatten()[0]
            start_one_batch = time.time()
            if (update == 1):
                x_u, y_u, _ = self._batch_to_Xy(update_x.float(), update_y.float())
                bufX.append(x_u); bufY.append(y_u)
                if (i % update_every == 0) and (len(bufY) >= 5):
                    X_update = np.concatenate(bufX, 0)
                    Y_update = np.concatenate(bufY, 0)
                    w = ema_weights(len(Y_update), self.rho)
                    self.model.fit(X_update, Y_update, sample_weight=w)


            Y_hat = self.model.predict(X)  # numpy (B, H*Csel)
            end_one_batch = time.time()
            B = Y.shape[0]
            y_hat = torch.as_tensor(
                Y_hat.reshape(B, self.args.pred_len, Csel),
                dtype=torch.float32, device=self.device
            )
            y_true = torch.as_tensor(
                Y.reshape(B, self.args.pred_len, Csel),
                dtype=torch.float32, device=self.device
            )
            preds.append(y_hat)
            trues.append(y_true)
            if (update == 1):
                ct.append(end_one_batch-start_one_batch)

        if len(preds) == 0:
            raise RuntimeError("predict_loader: got zero batches from loader.")

        return torch.cat(preds, dim=0).detach().cpu().numpy(), torch.cat(trues, dim=0).detach().cpu().numpy(), ct

    def train(self, setting, train_loader=None, vali_loader=None, early_stop=True):
        if train_loader is None:
            _, train_loader = self._get_data(flag='train')
        if early_stop and (vali_loader is None):
            _, vali_loader = self._get_data(flag='val')

        X_tr, Y_tr, _ = self._collect_from_loader(train_loader)

        self.model.fit(X_tr, Y_tr)

        best_val = np.inf
        if vali_loader is not None:
            pred, true = self._predict_loader(vali_loader)
            best_val = torch.mean((pred - true) ** 2).item()

        ckpt_dir = os.path.join(self.args.checkpoints, setting)
        os.makedirs(ckpt_dir, exist_ok=True)
        joblib.dump(self.model, os.path.join(ckpt_dir, 'checkpoint.pkl'))

        return self.model, best_val

    def vali(self, vali_loader, _criterion=None):
        with torch.no_grad():
            pred, true = self._predict_loader(vali_loader)
            return torch.mean((pred - true) ** 2).item()

    def test(self, setting):
        ckpt = os.path.join(self.args.checkpoints, setting, 'checkpoint.pkl')
        if os.path.exists(ckpt):
            self.model = joblib.load(ckpt)

        _, test_loader = self._get_data(flag='test')
        start = time.time()
        with torch.no_grad():
            preds, trues, ct = self._predict_and_update_loader(test_loader)
        exp_time = time.time() - start

        if self.view_shape: print('test shape:', preds.shape, trues.shape)

        MAE, MSE, RMSE, MAPE, MSPE = metric(preds, trues)
        mae, mse, rmse, mape, mspe = MAE[-1], MSE[-1], RMSE[-1], MAPE[-1], MSPE[-1]
        Results = {'MAE': MAE, 'MSE': MSE, 'preds': preds, 'trues': trues}
        Stats = {'comp_time': ct, 'cpu_memory': 0, 'gpu_memory': 0,
                 'total_memory': 0, 'num_params': 0, 'latency': [0], 'selected_size': [0]}
        return [mae, mse, rmse, mape, mspe, exp_time], Results, Stats

    def _process_one_batch(self, data, uflag=0, data_update=[None]*5, mode='inference'):
        [batch_x, batch_y, batch_x_mark, batch_y_mark, x_dec] = data
        X, Y, Csel = self._batch_to_Xy(batch_x.float(), batch_y.float())
        Y_hat = self.model.predict(X)  # numpy
        B = Y.shape[0]; H = self.args.pred_len
        y_pred = torch.as_tensor(
            Y_hat.reshape(B, H, Csel), dtype=torch.float32, device=self.device
        )
        y_true = torch.as_tensor(
            Y.reshape(B, H, Csel), dtype=torch.float32, device=self.device
        )
        return y_pred, y_true

    def get_model_stats(self):
        return 0, 0, 0  # cpu_mem, gpu_mem, num_params=0


# ===================== KRR: Kernel Ridge Regression ==========================
class Exp_KernelRidge(_BaseSKExp):
    def __init__(self, args):
        super().__init__(args)
        self.args = args
        self.model_init(args)

    def model_init(self, args):
        alpha  = args.krr_alpha
        kernel = args.krr_kernel
        gamma  = args.krr_gamma
        degree = args.krr_degree
        coef0  = args.krr_coef0
        self.model = KernelRidge(kernel=kernel, alpha=alpha, gamma=gamma, degree=degree, coef0=coef0)
    
    def grid_search(self, config, setting):
        args = self.args
        best_params ={"krr__alpha": args.krr_alpha,
                      "krr__gamma": args.krr_gamma,
                      "krr__degree": args.krr_degree,
                      "krr__coef0": args.krr_coef0,
                      }
        best_vali_loss = np.inf
        if args.verbose: print('>>> Started grid search', flush=True)

        alpha_list = [1e-2, 1e-1, 1.0, 10.0]
        gamma_list = [None, 1e-3, 1e-2, 1e-1, 1.0] if args.krr_kernel in ("rbf","laplacian","sigmoid") else [None]
        degree_list = [2, 3, 4] if args.krr_kernel == "poly" else [best_params["krr__degree"]]
        coef0_list = [0.0, 1.0] if args.krr_kernel in ("poly","sigmoid") else [best_params["krr__coef0"]]

        for alpha in alpha_list:
            args.krr_alpha = alpha
            for gamma in gamma_list:
                args.krr_gamma = gamma
                for degree in degree_list:
                    args.krr_degree = degree
                    for coef0 in coef0_list:
                        args.krr_coef0 = coef0
                        self.model_init(args)  # set experiments
                        _, vali_loss = self.train(setting)
                        if vali_loss < best_vali_loss:
                            best_params["krr__alpha"] = alpha
                            best_params["krr__gamma"] = gamma
                            best_params["krr__degree"] = degree
                            best_params["krr__coef0"] = coef0
                            best_vali_loss = vali_loss

        self.args.krr_alpha = best_params["krr__alpha"]
        self.args.krr_gamma = best_params["krr__gamma"]
        self.args.krr_degree = best_params["krr__degree"]
        self.args.krr_coef0 = best_params["krr__coef0"]
        self.model_init(self.args)
